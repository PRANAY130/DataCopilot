# ---- Python / Backend ----
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.env
backend/.env.*
backend/*.log
backend/uploads/
backend/tmp/
backend/models/saved/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ---- Next.js / Frontend ----
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---- Environment & Secrets ----
.env
.env.*
*.env
secrets.json
firebase-adminsdk*.json
service-account*.json

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editors ----
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.iml
.project
.classpath

# ---- Testing ----
.pytest_cache/
.coverage
coverage/
htmlcov/
.nyc_output/

# ---- Docker ----
*.dockerignore
docker-compose.override.yml

# ---- Misc ----
*.log
*.tmp
*.bak
*.orig
.cache/
